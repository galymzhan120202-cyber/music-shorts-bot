# Music Shorts Bot - API Keys and Configuration
# ЕСКЕРТУ: Нақты кілттермен толтырып, файл атауын .env етіп сақтаңыз.
# .env файлы .gitignore-де, GitHub-қа ешқашан жүктелмейді.

# Gemini API Key (басқа боттармен бірдей кілтті қолдануға болады,
# бірақ сол жағдайда cron уақыттарын ығыстырыңыз — POST_TIMES қараңыз)
GEMINI_API_KEY=

# Pexels API кілті (тегін, pexels.com/api тіркеліп бірден аласыз)
# Фон видеоларды әр жүктеу сайын автоматты, жаңа music-тақырыпты stock footage-пен
# ауыстырады (концерт, винил, студия, т.б.). Кілт бос болса — backgrounds/
# папкасындағы локал файлдарға сүйенеді.
PEXELS_API_KEY=

# Deezer API кілт керек ЕМЕС (ашық, тегін chart+preview endpoint).
# Әр видео трендтегі әндердің бірінің 30 секундтық ресми preview-ін
# әуен ретінде қолданады. Толық сәтсіз болса, music/fallback*.mp3-ке түседі.

# Edge TTS дауысы (тегін, API кілт керек емес)
# Ер: en-US-GuyNeural (viral Shorts-та ең танымал), en-US-RogerNeural, en-US-AndrewNeural, en-US-EricNeural, en-GB-RyanNeural
# Әйел: en-US-JennyNeural, en-US-AriaNeural
EDGE_TTS_VOICE=en-US-GuyNeural

# Трендтегі әннің дауыс астында қаншалық естілетінін реттейді (0.0-1.0)
MUSIC_VOLUME=0.15

# Telegram хабарламалары (қате/сәтті болса хабарлайды)
TELEGRAM_NOTIFY_TOKEN=
TELEGRAM_NOTIFY_CHAT_ID=

# Күнде 3 жүктеу уақыты (UTC, үтірмен бөлу)
# Психология (03:00,09:00,15:00) және AI/Tech (03:30,09:30,15:30) боттарымен
# соқтығыспас үшін ығыстырылған
POST_TIMES=04:00,10:00,16:00

# Базовая директория (обычно текущая папка)
BASE_DIR=.

# YouTube видеоның параметрлері (10 = Music)
YOUTUBE_CATEGORY_ID=10
YOUTUBE_PRIVACY_STATUS=public
YOUTUBE_MADE_FOR_KIDS=false

# Видео құру параметрлері
VIDEO_CODEC=libx264
AUDIO_CODEC=aac
VIDEO_FPS=24
VIDEO_PRESET=ultrafast

# Сценарий ұзындығы (секунд)
MIN_SCRIPT_LENGTH=20
MAX_SCRIPT_LENGTH=50

# Қайтара сынау параметрлері
MAX_RETRIES=3
RETRY_DELAY=2
